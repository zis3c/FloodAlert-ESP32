[
  {
    "id": "tab_flood_monitor",
    "type": "tab",
    "label": "Flood Monitor",
    "disabled": false,
    "info": "ESP32 flood telemetry to InfluxDB"
  },
  {
    "id": "mqtt_broker_local",
    "type": "mqtt-broker",
    "name": "MQTT Broker",
    "broker": "192.168.1.10",
    "port": "1883",
    "clientid": "",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "birthMsg": {},
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "closeMsg": {},
    "willTopic": "",
    "willQos": "0",
    "willPayload": "",
    "willMsg": {}
  },
  {
    "id": "mqtt_in_telemetry",
    "type": "mqtt in",
    "z": "tab_flood_monitor",
    "name": "ESP32 Telemetry",
    "topic": "floodmonitor/telemetry",
    "qos": "0",
    "datatype": "auto",
    "broker": "mqtt_broker_local",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 170,
    "y": 120,
    "wires": [["json_parse_telemetry"]]
  },
  {
    "id": "json_parse_telemetry",
    "type": "json",
    "z": "tab_flood_monitor",
    "name": "Parse JSON",
    "property": "payload",
    "action": "obj",
    "pretty": false,
    "x": 360,
    "y": 120,
    "wires": [["function_to_influx"]]
  },
  {
    "id": "function_to_influx",
    "type": "function",
    "z": "tab_flood_monitor",
    "name": "Map to Influx",
    "func": "const p = msg.payload;\n\nmsg.payload = {\n  measurement: 'flood_monitor',\n  tags: {\n    device: 'esp32-flood-monitor',\n    location: 'main_site'\n  },\n  fields: {\n    distance_cm: Number(p.distance_cm),\n    water_level_percent: Number(p.water_level_percent),\n    rain_detected: p.rain_detected ? 1 : 0,\n    temperature_c: Number(p.temperature_c),\n    humidity_percent: Number(p.humidity_percent),\n    flood_alert: p.flood_alert ? 1 : 0,\n    alarm_active: p.alarm_active ? 1 : 0,\n    wifi_rssi: Number(p.wifi_rssi)\n  }\n};\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 560,
    "y": 120,
    "wires": [["influxdb_out_telemetry", "debug_telemetry"]]
  },
  {
    "id": "debug_telemetry",
    "type": "debug",
    "z": "tab_flood_monitor",
    "name": "Debug telemetry",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 780,
    "y": 180,
    "wires": []
  },
  {
    "id": "mqtt_in_status",
    "type": "mqtt in",
    "z": "tab_flood_monitor",
    "name": "ESP32 Status",
    "topic": "floodmonitor/status",
    "qos": "0",
    "datatype": "auto",
    "broker": "mqtt_broker_local",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 160,
    "y": 220,
    "wires": [["debug_status"]]
  },
  {
    "id": "debug_status",
    "type": "debug",
    "z": "tab_flood_monitor",
    "name": "Debug status",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 360,
    "y": 220,
    "wires": []
  },
  {
    "id": "influxdb_config_main",
    "type": "influxdb",
    "hostname": "127.0.0.1",
    "port": "8086",
    "protocol": "http",
    "database": "flood_monitor",
    "name": "InfluxDB",
    "usetls": false,
    "tls": "",
    "influxdbVersion": "1.x",
    "url": "http://127.0.0.1:8086",
    "rejectUnauthorized": true
  },
  {
    "id": "influxdb_out_telemetry",
    "type": "influxdb out",
    "z": "tab_flood_monitor",
    "influxdb": "influxdb_config_main",
    "name": "Write telemetry",
    "measurement": "",
    "precision": "",
    "retentionPolicy": "",
    "x": 790,
    "y": 120,
    "wires": []
  }
]
