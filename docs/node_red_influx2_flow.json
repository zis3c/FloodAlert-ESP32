  {
    "id": "function_build_line",
    "type": "function",
    "z": "tab_flood_influx2",
    "name": "Build Influx line protocol",
    "func": "const p = msg.payload || {};\n\nconst num = (value, fallback = -999) => {\n  const n = Number(value);\n  return Number.isFinite(n) ? n : fallback;\n};\n\nconst boolField = (value) => (value ? 'true' : 'false');\n\nconst measurement = 'flood_monitor';\nconst tags = 'device=esp32-flood-monitor,location=main_site';\nconst fields = [\n  `distance_cm=${num(p.distance_cm)}`,\n  `water_level_percent=${num(p.water_level_percent)}`,\n  `rain_detected=${boolField(p.rain_detected)}`,\n  `temperature_c=${num(p.temperature_c)}`,\n  `humidity_percent=${num(p.humidity_percent)}`,\n  `flood_alert=${boolField(p.flood_alert)}`,\n  `alarm_active=${boolField(p.alarm_active)}`,\n  `wifi_rssi=${num(p.wifi_rssi)}`\n].join(',');\n\nconst org = env.get('INFLUX_ORG') || 'flood-org';\nconst bucket = env.get('INFLUX_BUCKET') || 'flood_telemetry';\nconst token = env.get('INFLUX_TOKEN') || 'change_me_influx_token';\nconst baseUrl = env.get('INFLUX_URL') || 'http://INFLUXDB_HOST:8086';\n\nmsg.method = 'POST';\nmsg.url = `${baseUrl.replace(/\\/$/, '')}/api/v2/write?org=${encodeURIComponent(org)}&bucket=${encodeURIComponent(bucket)}&precision=ns`;\nmsg.headers = {\n  Authorization: `Token ${token}`,\n  'Content-Type': 'text/plain; charset=utf-8'\n};\nmsg.payload = `${measurement},${tags} ${fields}`;\nmsg._influx_target = { org, bucket };\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 620,
    "y": 120,
    "wires": [["http_write_influx", "debug_line"]]
  },
